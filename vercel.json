{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "ncsyf.com.ng"
        }
      ],
      "destination": "https://admin.ncsyf.com.ng",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "www.ncsyf.com.ng"
        }
      ],
      "destination": "https://admin.ncsyf.com.ng",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "ncsyf.com.ng"
        }
      ],
      "destination": "https://admin.ncsyf.com.ng/:path*",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ncsyf.com.ng"
        }
      ],
      "destination": "https://admin.ncsyf.com.ng/:path*",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "admin.ncsyf.com.ng"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin.ncsyf.com.ng"
        }
      ],
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.ncsyf.com.ng"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "admin.ncsyf.com.ng"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.ncsyf.com.ng"
        }
      ],
      "destination": "/admin/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://adzfoiffpvdzbtbxqpqf.supabase.co; connect-src 'self' https://adzfoiffpvdzbtbxqpqf.supabase.co wss://adzfoiffpvdzbtbxqpqf.supabase.co; img-src 'self' data: blob: https://adzfoiffpvdzbtbxqpqf.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ]
}
