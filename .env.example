# NCSYF Portal Environment Configuration Template
# Copy to .env for local administrative scripts or backend server environments.
# NEVER commit real secret keys to source control.

# Supabase Public API Configuration (Exposed to browser clients)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_public_anon_key

# Supabase Service Role Secret Key (STRICTLY SERVER-SIDE / OPERATOR ONLY)
# Used exclusively for administrative scripts (e.g., auto_confirm_users.js)
SUPABASE_SECRET_KEY=your_private_service_role_key_here
