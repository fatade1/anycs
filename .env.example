# NCSYF Portal Environment Configuration Template
# Copy to .env for local administrative scripts or backend server environments.
# NEVER commit real secret keys or passwords to source control.

# Supabase Public API Configuration (Exposed to browser clients)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_public_anon_key

# Supabase Service Role Secret Key (STRICTLY SERVER-SIDE / OPERATOR ONLY)
# Used exclusively for administrative scripts (e.g., auto_confirm_users.js)
SUPABASE_SECRET_KEY=your_private_service_role_key_here

# Zoho ZeptoMail SMTP Configuration (STRICTLY SERVER-SIDE / VERCEL ENVIRONMENT VARIABLES)
# Never expose these credentials to browser clients or frontend bundles.
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailapikey
SMTP_PASS=your_zeptomail_password_here
SMTP_FROM_NAME=NCSYF
SMTP_FROM_EMAIL=admin@ncsyf.com.ng

# Secretariat Notification Inbox for New Member Application Alerts
ADMIN_NOTIFICATION_EMAIL=admin@ncsyf.com.ng
